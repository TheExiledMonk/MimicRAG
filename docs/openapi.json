{
  "openapi": "3.1.0",
  "info": {"title": "MimicRAG HTTP API", "version": "1.5.0"},
  "servers": [{"url": "http://127.0.0.1:8080"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {"get": {"operationId": "health", "responses": {"200": {"description": "Health status"}}}},
    "/ready": {"get": {"operationId": "ready", "responses": {"200": {"description": "Readiness status"}}}},
    "/openapi.json": {"get": {"operationId": "openapi", "responses": {"200": {"description": "OpenAPI document"}}}},
    "/v1/documents": {"post": {"operationId": "ingestDocument", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestRequest"}}}}, "responses": {"200": {"description": "Ingestion result"}}}},
    "/v1/documents/{document_id}": {"delete": {"operationId": "deleteDocument", "parameters": [{"name": "document_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Deletion result"}}}},
    "/v1/retrieve": {"post": {"operationId": "retrieve", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueryRequest"}}}}, "responses": {"200": {"description": "Ranked evidence"}}}},
    "/v1/answers": {"post": {"operationId": "answer", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueryRequest"}}}}, "responses": {"200": {"description": "Cited answer"}}}},
    "/v1/graph/expand": {"post": {"operationId": "expandGraph", "responses": {"200": {"description": "Related nodes"}}}},
    "/v1/feedback": {"post": {"operationId": "recordFeedback", "responses": {"200": {"description": "Feedback result"}}}},
    "/v1/evaluations": {"post": {"operationId": "evaluate", "responses": {"200": {"description": "Evaluation metrics"}}}},
    "/v1/storage": {"get": {"operationId": "storage", "responses": {"200": {"description": "Storage statistics"}}}},
    "/v1/traces": {"get": {"operationId": "listTraces", "responses": {"200": {"description": "Recent traces"}}}},
    "/v1/traces/{trace_id}": {"get": {"operationId": "getTrace", "parameters": [{"name": "trace_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Trace"}}}},
    "/v1/jobs/{job_id}": {"get": {"operationId": "getJob", "responses": {"200": {"description": "Job"}}}, "delete": {"operationId": "cancelJob", "responses": {"200": {"description": "Cancellation result"}}}},
    "/v1/chat/completions": {"post": {"operationId": "createChatCompletion", "responses": {"200": {"description": "OpenAI-compatible chat completion"}}}}
  },
  "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}}, "schemas": {
    "IngestRequest": {"type": "object", "required": ["text", "source_uri"], "properties": {"text": {"type": "string"}, "source_uri": {"type": "string"}, "tenant_id": {"type": "string"}, "metadata": {"type": "object"}}},
    "QueryRequest": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "tenant_id": {"type": "string"}, "access_scope": {"type": "string"}, "top_k": {"type": "integer", "minimum": 1, "maximum": 100}}}
  }}
}
