{
  "database": "mimicrag",
  "tenant_id": "default",
  "storage": {
    "backend": "network",
    "host": "127.0.0.1",
    "port": 9000,
    "identity_key_path": "/etc/mimicdb/client.key"
  },
  "local_embedding": {
    "enabled": true,
    "eager_dual_index": true,
    "model_path": "models/nomic-embed-text-v1.5.Q4_K_M.gguf",
    "gpu_layers": -1,
    "threads": 0,
    "context_size": 2048,
    "document_prefix": "search_document: ",
    "query_prefix": "search_query: "
  },
  "graph": {
    "enabled": true,
    "max_seeds": 5,
    "max_neighbors": 32,
    "max_section_children": 8,
    "min_seed_score": 0.01
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "api_key_env": "MIMICRAG_API_KEY",
    "requests_per_minute": 120,
    "max_query_chars": 16000,
    "max_document_chars": 10000000,
    "context_token_budget": 4000,
    "answer_max_tokens": 1024,
    "data_path": "data/mimicrag_cpp",
    "worker_threads": 0,
    "job_workers": 1,
    "trace_memory": 10000,
    "trace_path": "data/mimicrag/traces.jsonl"
  },
  "chat": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-5",
    "api_key_env": "ANTHROPIC_API_KEY"
  },
  "embedding": {
    "provider": "openai_compatible",
    "model": "text-embedding-model",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "LOCAL_MODEL_API_KEY"
  }
}
