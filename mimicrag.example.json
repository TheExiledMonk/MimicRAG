{
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "data_path": "data/mimicrag_cpp",
    "max_body_bytes": 10485760,
    "max_query_chars": 16000,
    "context_chars": 16000,
    "top_k": 10,
    "worker_threads": 0,
    "job_workers": 1,
    "requests_per_minute": 120,
    "answer_max_tokens": 1024,
    "trace_memory": 10000,
    "trace_path": "data/mimicrag_cpp/traces.jsonl",
    "trace_max_bytes": 67108864,
    "audit_log_path": "data/mimicrag_cpp/audit.jsonl",
    "audit_log_max_bytes": 67108864,
    "capacity_warning_bytes": 1073741824,
    "memory_warning_bytes": 0,
    "index_warning_bytes": 0,
    "retention_days": 0,
    "keys": [
      {
        "id": "primary-agent",
        "key_env": "MIMICRAG_API_KEY",
        "permissions": ["read", "write", "admin"],
        "tenants": [],
        "scopes": [],
        "query_requests_per_minute": 120,
        "ingestion_requests_per_minute": 30,
        "provider_requests_per_minute": 60,
        "storage_bytes": 0
      }
    ]
  },
  "local_embedding": {
    "enabled": true,
    "eager_dual_index": true,
    "model_path": "models/nomic-embed-text-v1.5.Q4_K_M.gguf",
    "gpu_layers": -1,
    "threads": 0,
    "context_size": 2048,
    "document_prefix": "search_document: ",
    "query_prefix": "search_query: "
  },
  "embedding": {
    "provider": "local",
    "model": "nomic-embed-text-v1.5"
  },
  "chat": {
    "provider": "openai_compatible",
    "model": "your-chat-model",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 60,
    "max_retries": 2
  },
  "graph": {
    "enabled": true,
    "max_seeds": 5,
    "max_neighbors": 32,
    "max_section_children": 8,
    "min_seed_score": 0.01
  }
}
