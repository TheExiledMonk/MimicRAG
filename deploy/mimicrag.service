[Unit]
Description=MimicRAG retrieval and generation server
After=network-online.target mimicdb.service

[Service]
Type=simple
WorkingDirectory=/opt/mimicdb
Environment=MIMICRAG_CONFIG=/etc/mimicdb/mimicrag.json
EnvironmentFile=-/etc/mimicdb/mimicrag.env
ExecStart=/opt/mimicdb/.venv/bin/python -m mimicrag --config /etc/mimicdb/mimicrag.json serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mimicdb

[Install]
WantedBy=multi-user.target
