[Unit]
Description=Native C++ MimicRAG server
After=network-online.target

[Service]
Type=simple
User=mimicrag
Group=mimicrag
WorkingDirectory=/opt/mimicdb
EnvironmentFile=/etc/mimicdb/mimicrag.env
ExecStart=/opt/mimicdb/build-release/rag_cpp/mimicrag_server serve --config /etc/mimicdb/mimicrag.json
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mimicdb

[Install]
WantedBy=multi-user.target
